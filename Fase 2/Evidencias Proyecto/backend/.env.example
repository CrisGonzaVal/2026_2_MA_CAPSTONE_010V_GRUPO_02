# Variables de conexion del backend.
# En local no hace falta crear un `.env` aqui: el backend lee el `.env` de la
# raiz del proyecto (donde tambien vive Clerk). Esta plantilla documenta el
# bloque `DB_*` que debe llevar ese archivo y lo que necesita un backend
# aislado (Render, VPS) por variables de entorno.

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# Desde el host el puerto publicado es 5433 (ver docker-compose.yml); dentro de
# la red docker es 5432 y lo inyecta docker-compose.
DB_PORT=5433
DB_NAME=apt_erp

# Alternativa: cadena completa (Neon, Render, VPS). Si esta definida manda sobre
# las variables DB_* de arriba. Acepta `postgres://` o `postgresql://`.
# Se llama DB_URL y no DATABASE_URL para no chocar con la variable generica que
# otras herramientas o proyectos de la maquina ya usan.
# DB_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk (Feature 006) vive en el `.env` de la raiz del proyecto, que alimenta a
# docker compose y que el backend tambien lee. No lo dupliques aqui: los valores
# de este archivo tienen prioridad y un placeholder romperia el login.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_ISSUER=https://tu-instancia.clerk.accounts.dev
