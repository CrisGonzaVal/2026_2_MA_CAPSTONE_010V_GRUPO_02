{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "agents": {
    "build": { "model": "opencode/deepseek-v4.1-flash-free" },
    "plan": { "model": "opencode/deepseek-v4.1-flash-free" },
    "general": { "model": "opencode/deepseek-v4.1-flash-free" },
    "explore": { "model": "opencode/deepseek-v4.1-flash-free" },
    "coordinator": { "model": "opencode/deepseek-v4.1-flash-free" },
    "planner": { "model": "opencode/deepseek-v4.1-flash-free" },
    "implementer": { "model": "opencode/deepseek-v4.1-flash-free" },
    "reviewer": { "model": "opencode/deepseek-v4.1-flash-free" },
    "compaction": { "model": "opencode/deepseek-v4.1-flash-free" },
    "title": { "model": "opencode/deepseek-v4.1-flash-free" },
    "summary": { "model": "opencode/deepseek-v4.1-flash-free" }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5433/apt_erp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/all",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    }
  }
}